{
  "sourceLanguage" : "en",
  "strings" : {
    "%1$@ needs at least %2$@ of free disk space to start. Only %3$@ remains. Free up disk space and restart — the data directory often contains large files you can clean up." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ needs at least %2$@ of free disk space to start. Only %3$@ remains. Free up disk space and restart — the data directory often contains large files you can clean up."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 启动至少需要 %2$@ 的可用磁盘空间，当前仅剩 %3$@。请清理磁盘空间后重新启动——数据目录中通常有可以清理的大文件。"
          }
        }
      }
    },
    "%@ can only remind you while it is open. Turn on notifications to get reminders in the background." : {
